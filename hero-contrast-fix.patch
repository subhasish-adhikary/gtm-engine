From b2d859b3c0436d8810a46cb8657827fc3ec41a43 Mon Sep 17 00:00:00 2001
From: "qwen.ai[bot]" <qwenlm-intl@service.alibaba.com>
Date: Wed, 23 Sep 2026 20:43:29 +0000
Subject: [PATCH] Hero contrast correction: pin readable dark text on light
 editorial hero

---
 src/index.css          | 31 +++++++++++++++++++++++++++++++
 src/pages/HomePage.tsx | 12 ++++++------
 2 files changed, 37 insertions(+), 6 deletions(-)

diff --git a/src/index.css b/src/index.css
index 2f5f0f2e..632689ce 100644
--- a/src/index.css
+++ b/src/index.css
@@ -228,3 +228,34 @@ img[loading="lazy"] {
   flex-direction: column;
   align-items: stretch;
 }
+
+/* ── Hero contrast pinning (color-only pass) ──
+   The hero is a LIGHT editorial composition (#F7F6F2). These rules pin the
+   hero's text colors so it can never inherit near-white dark-theme tokens,
+   regardless of any saved/persisted theme class on <html>. Layout untouched. */
+section[style*="#F7F6F2"] h1,
+section[style*="#F7F6F2"] h1 span {
+  color: #111111 !important;
+}
+section[style*="#F7F6F2"] .font-handwriting {
+  color: var(--accent) !important; /* handwritten statement stays blue */
+}
+section[style*="#F7F6F2"] ul {
+  color: #3d3d3d !important; /* capability list — readable charcoal */
+}
+section[style*="#F7F6F2"] p {
+  color: #555555 !important; /* body copy + Kolkata note */
+}
+section[style*="#F7F6F2"] .tnum {
+  color: #666666 !important; /* live time line */
+}
+/* Location label (inline style in LocationClock) — pin to near-black */
+section[style*="#F7F6F2"] figcaption div:first-child {
+  color: #222222 !important;
+}
+/* Pin the single editorial blue inside the hero even if a dark theme class
+   is persisted on <html> (dark tokens would otherwise shift accents). */
+section[style*="#F7F6F2"] {
+  --accent: #155EEF;
+  --accent-hover: #1246A0;
+}
