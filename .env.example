# Kit (ConvertKit) newsletter integration — example environment.
# Copy to .env.local for local development (gitignored) and set the same keys in
# the Vercel project (Production / Preview / Development).
#
# Never commit a real key, and never expose it to client-side code.

# Kit v4 API key (https://api.kit.com/v4). Server-side only.
KIT_API_KEY=

# Kit form id that subscribers are added to. Defaults to 9947751 ("Newsletter site").
KIT_FORM_ID=9947751

# Optional Kit tag id applied to every subscriber.
KIT_TAG_ID=
