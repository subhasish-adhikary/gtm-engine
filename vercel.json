{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.subhasishadhikary.com" }],
      "destination": "https://subhasishadhikary.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/static/:path*",
      "has": [{ "type": "host", "value": "cms.subhasishadhikary.com" }],
      "destination": "/studio/static/:path*"
    },
    {
      "source": "/static/:path*",
      "has": [{ "type": "header", "key": "x-forwarded-host", "value": "cms.subhasishadhikary.com" }],
      "destination": "/studio/static/:path*"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "cms.subhasishadhikary.com" }],
      "destination": "/studio"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "header", "key": "x-forwarded-host", "value": "cms.subhasishadhikary.com" }],
      "destination": "/studio"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "cms.subhasishadhikary.com" }],
      "headers": [{ "key": "x-rewrite-probe", "value": "host-cond" }]
    },
    {
      "source": "/:path*",
      "has": [{ "type": "header", "key": "x-forwarded-host", "value": "cms.subhasishadhikary.com" }],
      "headers": [{ "key": "x-rewrite-probe", "value": "xfh-cond" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/(llms.txt|llms-full.txt)",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=86400" }
      ]
    }
  ]
}
