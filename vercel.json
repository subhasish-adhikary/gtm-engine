{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.subhasishadhikary.com" }],
      "destination": "https://subhasishadhikary.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|images/|public/|llms.*|robots.txt|sitemap.xml).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/(llms.txt|llms-full.txt)",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/((?!assets/)[^.]*)",
      "headers": [{ "key": "Cache-Control", "value": "s-maxage=86400, stale-while-revalidate=86400" }]
    }
  ]
}
