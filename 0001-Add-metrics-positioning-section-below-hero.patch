diff --git a/src/pages/HomePage.tsx b/src/pages/HomePage.tsx
index 1cc5d097..e00f010a 100644
--- a/src/pages/HomePage.tsx
+++ b/src/pages/HomePage.tsx
@@ -133,6 +133,41 @@ export function HomePage() {
         </div>
